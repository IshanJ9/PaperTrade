# Copy to backend/.env (untracked) and fill in. Never commit real values.

# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PT_JWT_SECRET=change-me

# Docker Postgres from docker-compose.yml is published on host port 55432.
PT_DATABASE_URL=postgresql+psycopg://papertrade:papertrade@localhost:55432/papertrade
PT_REDIS_URL=redis://localhost:6379/0

# "simulated" (default, works any time) or "finnhub" (real US quotes, needs a free key from https://finnhub.io).
PT_PRICE_SOURCE=simulated
PT_FINNHUB_API_KEY=

# The schema comes from `uv run alembic upgrade head`. Leave false except for throwaway databases.
PT_AUTO_CREATE_TABLES=false
